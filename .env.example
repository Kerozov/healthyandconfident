# Copy to .env and fill in. Never commit the real file.

# ── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://www.healthyandconfident.co.uk"
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=""

# ── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""          # server only — bypasses RLS
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""      # reads published site content only (RLS)

# ── Admin ───────────────────────────────────────────────────────────
# Master password for the owner account; also signs admin session cookies.
ADMIN_SECRET=""
# Signs unsubscribe / click / form-invite links; falls back to ADMIN_SECRET.
# Set it on a fresh install. On a live site that never had it, adding it
# invalidates every unsubscribe link in emails already sent.
UNSUBSCRIBE_SECRET=""

# ── Notification worker (email + SMS) ──────────────────────────────
NOTIFICATION_WORKER_URL=""
NOTIFICATION_WORKER_API_KEY=""
NOTIFICATION_WORKER_FROM=""           # optional, defaults to the brand address
NOTIFICATION_WORKER_REPLY_TO=""       # optional

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Zoom ────────────────────────────────────────────────────────────
# Required in production — the webhook rejects every event without it.
ZOOM_WEBHOOK_SECRET=""

# ── Meta pixel / Conversions API (can also be set in /admin/meta) ─
META_PIXEL_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
META_CONVERSIONS_API_TOKEN=""
META_TEST_EVENT_CODE=""
META_DOMAIN_VERIFICATION=""

# ── FunnelBrand contact sync ────────────────────────────────────────
FUNNEL_BRAND_API_URL="https://www.funnel-brand.com"
FUNNEL_BRAND_API_KEY=""

CRON_SECRET=""
